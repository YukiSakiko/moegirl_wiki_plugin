{
  "manifest_version": 2,
  "version": "2.1.0",
  "name": "萌娘百科插件",
  "description": "为麦麦提供萌娘百科知识补充：词条摘要、主词条信息及相关语境，支持 generator=search 与 opensearch 双路径回退。",
  "author": {
    "name": "ValleyWinds",
    "url": "https://github.com/ValleyWinds"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/ValleyWinds/Moegirl-Wiki",
    "homepage": "https://github.com/ValleyWinds/Moegirl-Wiki",
    "documentation": "https://github.com/ValleyWinds/Moegirl-Wiki#readme",
    "issues": "https://github.com/ValleyWinds/Moegirl-Wiki/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
